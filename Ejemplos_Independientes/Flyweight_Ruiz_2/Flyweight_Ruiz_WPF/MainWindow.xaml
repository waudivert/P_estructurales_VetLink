<Window x:Class="Flyweight_Ruiz_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flyweight | Bosque compartido" Width="1060" Height="730"
        MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#F4F7F5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="127"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#246B4D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,21,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,19">
            <TextBlock Text="PATRÓN ESTRUCTURAL · FLYWEIGHT" Foreground="#247852" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="Bosque de árboles compartidos" FontSize="29" FontWeight="Bold" Foreground="#1B3529" Margin="0,4,0,5"/>
            <TextBlock Text="Cada árbol tiene su propia posición, pero pinos y robles reutilizan sus datos de apariencia." Foreground="#617568" FontSize="14"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="13" Padding="17,15" Margin="0,0,0,17">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButton}" Content="Generar 5 árboles" Click="GenerarCinco_Click"/>
                    <Button Style="{StaticResource ActionButton}" Content="Generar 100 árboles" Click="GenerarCien_Click"/>
                    <Button Style="{StaticResource ActionButton}" Background="#E7EEEA" Foreground="#246B4D" Content="Limpiar" Click="Limpiar_Click"/>
                </StackPanel>
                <TextBlock x:Name="Mensaje" Foreground="#64776C" Margin="0,13,0,0" FontSize="12"
                           Text="Presiona un botón para dibujar el bosque."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#DCEFE3" CornerRadius="15" ClipToBounds="True" BorderBrush="#C9E2D1" BorderThickness="1">
            <Grid>
                <Canvas x:Name="BosqueCanvas" ClipToBounds="True" Background="#DCEFE3" SizeChanged="BosqueCanvas_SizeChanged"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EFFFFFFF" CornerRadius="8" Padding="12,7" Margin="15">
                    <TextBlock Text="Vista del bosque" Foreground="#315943" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="13" Padding="20,15" Margin="0,17,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ÁRBOLES EN EL BOSQUE" Foreground="#718278" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ConteoArboles" Text="0" FontWeight="Bold" Foreground="#1E3D2E" FontSize="28"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="TIPOS COMPARTIDOS" Foreground="#718278" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ConteoTipos" Text="0" FontWeight="Bold" Foreground="#1E3D2E" FontSize="28"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="¿SE REUTILIZA EL PINO?" Foreground="#718278" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResultadoReutilizacion" Text="—" FontWeight="Bold" Foreground="#247852" FontSize="26"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
