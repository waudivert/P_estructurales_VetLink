<Window x:Class="Patrones_Estructurales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VetLink | Patrones estructurales"
        Height="740"
        Width="1250"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource SidebarStyle}">
            <StackPanel>
                <TextBlock Text="VetLink"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource ColorPrimario}"
                           Margin="0,15,0,3"/>
                <TextBlock Text="Patrones estructurales"
                           Foreground="{StaticResource TextoClaro}"
                           Margin="0,0,0,28"/>

                <Button Content="Adapter"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnAdapter_Click"/>
                <Button Content="Bridge"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnBridge_Click"/>
                <Button Content="Composite"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnComposite_Click"/>
                <Button Content="Decorator"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnDecorator_Click"/>
                <Button Content="Facade"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnFacade_Click"/>
                <Button Content="Proxy"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnProxy_Click"/>
                <Button Content="Flyweight"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="BtnFlyweight_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource ContentPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource ColorPrimario}"
                        CornerRadius="13"
                        Padding="22,18"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Patrones de diseño estructurales"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Plantilla de trabajo · VetLink · Ejercicios por implementar"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Foreground="#E4F4E9"/>
                    </StackPanel>
                </Border>
                <ContentControl x:Name="ContenedorContenido"
                                Grid.Row="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>
