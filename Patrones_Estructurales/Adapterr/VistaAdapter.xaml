<UserControl x:Class="Patrones_Estructurales.Adapterr.VistaAdapter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="350">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardStyle}"
                Margin="0,0,10,10">

            <StackPanel>

                <!-- Encabezado -->
                <TextBlock
                    Text="ADAPTER"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{StaticResource ColorPrimario}"/>

                <TextBlock
                    Text="Integración de datos ganaderos"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Margin="0,8,0,0"
                    Foreground="{StaticResource TextoOscuro}"/>

                <TextBlock
                    Text="Convierte registros de un sistema externo al formato utilizado por VetLink."
                    TextWrapping="Wrap"
                    Margin="0,8,0,20"
                    Foreground="{StaticResource TextoClaro}"/>

                <!-- Selección -->
                <Border
                    Background="{StaticResource InputColor}"
                    CornerRadius="12"
                    Padding="18">

                    <StackPanel>

                        <TextBlock
                            Text="Seleccionar animal"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"/>

                        <ComboBox
                            x:Name="CmbAnimales"
                            Height="38"
                            FontSize="14"
                            DisplayMemberPath="Etiqueta"
                            SelectedValuePath="Codigo"/>

                        <Button
                            x:Name="BtnAdaptar"
                            Content="Adaptar datos"
                            Click="BtnAdaptar_Click"
                            Background="{StaticResource ColorPrimario}"
                            Foreground="White"
                            BorderThickness="0"
                            Height="42"
                            Cursor="Hand"
                            Margin="0,15,0,0"/>

                    </StackPanel>
                </Border>

                <!-- Mensaje inicial -->
                <TextBlock
                    x:Name="TxtEstadoInicial"
                    Text="Selecciona un animal y presiona Adaptar datos."
                    Margin="0,20,0,0"
                    Foreground="{StaticResource TextoClaro}"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>

                <!-- Resultados -->
                <StackPanel
                    x:Name="PanelResultados"
                    Visibility="Collapsed"
                    Margin="0,22,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Datos externos -->
                        <Border
                            Grid.Column="0"
                            BorderBrush="{StaticResource BordesSuaves}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                            <StackPanel>

                                <TextBlock
                                    Text="Sistema externo"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextoOscuro}"/>

                                <TextBlock
                                    Text="Formato original"
                                    Foreground="{StaticResource TextoClaro}"
                                    Margin="0,4,0,14"/>

                                <TextBlock
                                    x:Name="TxtDatosExternos"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>

                        <!-- Datos adaptados -->
                        <Border
                            Grid.Column="2"
                            Background="{StaticResource InputColor}"
                            BorderBrush="{StaticResource BordesSuaves}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16">

                            <StackPanel>

                                <TextBlock
                                    Text="VetLink"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ColorPrimario}"/>

                                <TextBlock
                                    Text="Modelo adaptado"
                                    Foreground="{StaticResource TextoClaro}"
                                    Margin="0,4,0,14"/>

                                <TextBlock
                                    x:Name="TxtDatosVetLink"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Resultado final -->
                    <Border
                        Background="{StaticResource PrimarioSuave}"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,18,0,0">

                        <TextBlock
                            x:Name="TxtResultado"
                            Text="Datos adaptados correctamente."
                            Foreground="{StaticResource ColorPrimario}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>

                <!-- Explicación -->
                <Border
                    Background="{StaticResource InputColor}"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="¿Qué demuestra este patrón?"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextoOscuro}"/>

                        <TextBlock
                            Text="Adapter permite consultar datos de un sistema externo utilizando la interfaz que espera VetLink, sin modificar el sistema original."
                            TextWrapping="Wrap"
                            Margin="0,8,0,0"
                            Foreground="{StaticResource TextoClaro}"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
