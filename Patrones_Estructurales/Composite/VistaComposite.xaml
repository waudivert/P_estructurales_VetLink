<UserControl
    x:Class="Patrones_Estructurales.Composite.VistaComposite"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F8F5">

        <Border
            Background="White"
            CornerRadius="15"
            Margin="25"
            Padding="25">

            <StackPanel>

                <TextBlock
                    Text="COMPOSITE"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#267453"/>

                <TextBlock
                    Text="Carpetas y archivos"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="#173D30"
                    Margin="0,8,0,10"/>

                <TextBlock
                    Text="Selecciona un elemento para calcular su tamaño."
                    Foreground="#66776D"
                    Margin="0,0,0,20"/>

                <TreeView
                    x:Name="ArbolArchivos"
                    Height="230"
                    Background="#F4F8F5"
                    BorderThickness="0"
                    Padding="10"
                    SelectedItemChanged="ArbolArchivos_SelectedItemChanged"/>

                <TextBlock
                    x:Name="TxtSeleccion"
                    Text="Elemento: ninguno"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,20,0,10"/>

                <Button
                    Content="Calcular tamaño"
                    Height="42"
                    Background="#267453"
                    Foreground="White"
                    BorderThickness="0"
                    Click="BtnCalcular_Click"/>

                <Border
                    Background="#E5F2E9"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,20,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="TAMAÑO TOTAL"
                            Foreground="#267453"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="TxtTamaño"
                            Text="0 KB"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="#173D30"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
